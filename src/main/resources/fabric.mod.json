{
  "schemaVersion": 1,
  "id": "originscontent",
  "version": "${version}",
  "name": "OriginsContent",
  "description": "A collection of utilities for the Origin SMP.",
  "authors": ["Zac99LOL"],
  "contact": {},
  "license": "GPL-3.0",
  "icon": "assets/originscontent/icon.png",
  "environment": "*",
  "entrypoints": {
    "fabric-datagen": [
      "dev.zac99lol.originscontent.client.OriginsContentDataGenerator"
    ],
    "client": [
      "dev.zac99lol.originscontent.client.OriginsContentClient"
    ],
    "main": [
      "dev.zac99lol.originscontent.OriginsContent"
    ]
  },
  "mixins": [
    "originscontent.mixins.json",
    {
      "config": "originscontent.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric": "*",
    "minecraft": "${minecraft_version}",
    "cloth-config": "*"
  },
  "jars": [
    {
      "file": "META-INF/jars/create-fabric-6.0.8.1+build.1744-mc1.20.1.jar"
    }
  ]
}
