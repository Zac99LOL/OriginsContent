{
  "schemaVersion": 1,
  "id": "originscontent",
  "version": "${version}",
  "name": "OriginsContent",
  "description": "A collection of utilities for the Origin SMP.",
  "authors": ["Zac99LOL"],
  "contact": {},
  "license": "GPL-3.0",
  "icon": "assets/originscontent/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "dev.zac99lol.originscontent.OriginsContent"
    ],
    "client": [
      "dev.zac99lol.originscontent.client.OriginsContentClient"
    ],
    "cardinal-components": [
      "dev.zac99lol.originscontent.init.ModCardinalComponents"
    ],
    "emi": [
      "dev.zac99lol.originscontent.OriginsContentEmiPlugin"
    ],
    "jade": [
      "dev.zac99lol.originscontent.OriginsContentJadePlugin"
    ],
    "mixinsquared-adjuster": [
      "dev.zac99lol.originscontent.OriginsContentMixinAnnotationAdjuster"
    ]
  },
  "mixins": [
    "originscontent.mixins.json",
    {
      "config": "originscontent.client.mixins.json",
      "environment": "client"
    }
  ],
  "accessWidener": "originscontent.classtweaker",
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric": "*",
    "minecraft": "${minecraft_version}",
    "cloth-config": "*"
  },
  "breaks": {
    "essential": "*"
  },
  "custom": {
    "modmenu": {
      "badges": [
        "deprecated"
      ],
      "update_checker": false
    },
    "cardinal-components": [
      "originscontent:saved_origin"
    ]
  }
}
